# Copy to .podmanenv for local Podman Compose usage

# PostgreSQL settings
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=cardio

# SQLAlchemy connection string for backend container
DATABASE_URL=postgresql+psycopg://app:app@db:5432/cardio

# Admin authentication secrets
ADMIN_JWT_SECRET=replace-with-strong-secret
ADMIN_TOKEN_TTL_MINUTES=60
ADMIN_DEFAULT_EMAIL=admin@test.com
ADMIN_DEFAULT_PASSWORD=pass4admin

# Frontend build-time API endpoint (overridden per environment)
VITE_API_BASE_URL=http://backend:8000
